# ===== LLM / 임베딩 API =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== 크롤링 소스 =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:dev-hive:v1.0
GITHUB_TOKEN=

# ===== 데이터베이스 =====
# 로컬 개발: docker-compose 기준
DATABASE_URL=postgresql://devhive:devhive@localhost:5432/devhive

# ===== 백엔드 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 크롤 스케줄러 =====
# 1로 설정하면 APScheduler 백그라운드 크롤 활성화 (프로덕션 필수)
ENABLE_SCHEDULER=0

# ===== 크롤 품질 필터 =====
# Reddit PRAW: 본문 최소 길이 (링크 포스트·짧은 글 제외, reddit_public_crawler의 REDDIT_MIN_BODY와 별개)
REDDIT_PRAW_MIN_BODY=300

# ===== 프론트엔드 (web / Next.js) =====
# 백엔드 API 주소 (web BFF가 서버사이드에서 호출)
API_BASE_URL=http://localhost:8000
